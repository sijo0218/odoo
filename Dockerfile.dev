FROM ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8

# Remove default ubuntu user (UID 1000) so we can create odoo user with UID 1000
RUN userdel -r ubuntu 2>/dev/null || true

# Install base dependencies and python3 packages from Ubuntu repositories
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales \
    curl \
    git \
    build-essential \
    ca-certificates \
    postgresql-client \
    libldap2-dev \
    libsasl2-dev \
    libpq-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-asn1crypto \
    python3-babel \
    python3-cbor2 \
    python3-dateutil \
    python3-docutils \
    python3-geoip2 \
    python3-gevent \
    python3-h11 \
    python3-ldap \
    python3-pil \
    python3-jinja2 \
    python3-libsass \
    python3-lxml \
    python3-lxml-html-clean \
    python3-magic \
    python3-ofxparse \
    python3-openpyxl \
    python3-passlib \
    python3-polib \
    python3-psutil \
    python3-psycopg2 \
    python3-openssl \
    python3-pypdf \
    python3-rjsmin \
    python3-qrcode \
    python3-renderpm \
    python3-reportlab \
    python3-requests \
    python3-serial \
    python3-setuptools \
    python3-stdnum \
    python3-usb \
    python3-vobject \
    python3-werkzeug \
    python3-xlsxwriter \
    python3-zeep \
    && rm -rf /var/lib/apt/lists/*

# Install any additional pip packages if missing from apt
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt || true

# Create odoo user and data directory
RUN useradd -ms /bin/bash -u 1000 odoo && \
    mkdir -p /var/lib/odoo /workspace/odoo && \
    chown -R odoo:odoo /var/lib/odoo

WORKDIR /workspace/odoo
USER odoo

EXPOSE 8069 8072

ENTRYPOINT ["python3", "odoo-bin"]
CMD ["-d", "odoo_dev", "--db_host=db", "--db_user=odoo", "--db_password=odoo", "--http-interface=0.0.0.0", "--dev=reload,qweb,xml"]
